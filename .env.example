COMPOSE_PROJECT_NAME=bbpipeline

# Keep administrative ports on loopback. To bind to a Tailscale address, replace
# 127.0.0.1 with the VPS's `tailscale ip -4` result.
DASHBOARD_BIND=127.0.0.1
GRAFANA_PORT=3000
API_BIND=127.0.0.1
API_PORT=8080

SECRETS_DIR=/etc/bug-bounty-automation/secrets
EVIDENCE_VOLUME=bbpipeline_evidence
POSTGRES_VOLUME=bbpipeline_postgres
GRAFANA_VOLUME=bbpipeline_grafana

POSTGRES_DB=bbpipeline
POSTGRES_USER=bbpipeline

# Image tags are explicit so upgrades are reviewed. For production, replace the
# values with tag@sha256:digest after the pilot build has been tested.
POSTGRES_IMAGE=postgres:17.10-bookworm
GRAFANA_IMAGE=grafana/grafana:12.4.0
PYTHON_IMAGE=python:3.12-slim-bookworm
BBOT_BASE_IMAGE=blacklanternsecurity/bbot:stable-full
BBOT_VERSION=3.0.1
NUCLEI_VERSION=3.11.1
NUCLEI_TEMPLATES_VERSION=10.4.7
NUCLEI_TEMPLATES_COMMIT=83234ce
# Pinned below 8.30.x pending resolution of its reported default-rule regression.
GITLEAKS_VERSION=8.28.0
CODEX_VERSION=0.147.0
CLAUDE_CODE_VERSION=2.1.234

BB_LOG_LEVEL=INFO
BB_WORKER_POLL_SECONDS=5
BB_SCHEDULER_POLL_SECONDS=30
BB_JOB_LEASE_SECONDS=7200
BB_DEFAULT_RETENTION_DAYS=90
BB_MAX_CONTEXT_BYTES=32768

# Leave blank to use each authenticated CLI's configured/default model.
BB_CODEX_MODEL=
BB_CLAUDE_MODEL=
